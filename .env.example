# Tauri desktop configuration. Browser-hosted builds are not supported.
#
# HTTPS origin of an operator-deployed Cloud Run API. The repository does not
# imply that this service already exists. Do not include a trailing slash.
VITE_BACKEND_BASE_URL=

# Shared Google config (required for both managers and employees).
# Use a "Desktop app" OAuth client. Google's token endpoint still requires the
# Desktop client secret alongside PKCE; it is not a confidential server secret.
# Do not commit the real secret; set it in .env / CI secrets only.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Canonical workflow/compatibility workbook. Firestore, not this workbook,
# is authoritative for membership, roles, invitations, and onboarding.
VITE_ADMIN_SPREADSHEET_ID=
