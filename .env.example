# Shared Google config (required for both managers and employees).
VITE_GOOGLE_CLIENT_ID=

# Comma- or newline-separated lists of allowed accounts. Anyone signing in with
# an email in the manager list gets the manager dashboard; anyone in the employee
# list gets the kanban workspace; everyone else is shown an unauthorized notice.
VITE_MANAGER_EMAILS=
VITE_EMPLOYEE_EMAILS=

# Manager-only: the admin spreadsheet that holds SheetRegistry / RunLog /
# Feedback / Roles. Employees never need this value.
VITE_ADMIN_SPREADSHEET_ID=
