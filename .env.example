# Tauri desktop configuration. Browser-hosted builds are not supported.
#
# HTTPS origin of an operator-deployed Cloud Run API. The repository does not
# imply that this service already exists. Do not include a trailing slash.
VITE_BACKEND_BASE_URL=

# Shared Google config (required for both managers and employees).
# Use a "Desktop app" OAuth client. The desktop app performs PKCE but never
# holds the client secret: the backend brokers Google's token endpoint and
# reads the secret from Secret Manager as GOOGLE_OAUTH_CLIENT_SECRET.
# Setting VITE_GOOGLE_CLIENT_SECRET here is rejected by check:build-config.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
