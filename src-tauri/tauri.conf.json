{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lab Workflow Desktop",
  "version": "0.1.2",
  "identifier": "com.labworkflow.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run frontend:build:configured",
    "frontendDist": "../dist"
  },
  "plugins": {
    "oauth": "<html><body style=\"font-family:-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;padding:48px;text-align:center;\"><h1>Sign-in complete</h1><p>You can close this tab and return to Lab Workflow Desktop.</p></body></html>",
    "updater": {
      "endpoints": [
        "https://github.com/aadish98/LabProjectManagementDashboard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMDE0NkQxNjBDNjY0ODQKUldTRVpNWmcwVVlCSHlsK3R3Z29oaHZBU00rZEhZRzBKR0VPYVdXdzVKVlpCQkVOVmdNektkYnEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Lab Workflow Desktop",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#191917"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Employee submission forms and manager dashboards for the lab workflow.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
