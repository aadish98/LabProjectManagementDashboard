# Cloud Run injects PORT. Keep 8080 for local Docker runs.
PORT=8080

# Google Cloud project containing Firestore and the Cloud Run service.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE_ID=(default)

# Comma-separated OAuth client IDs accepted as Google ID-token audiences.
# Include each supported Tauri desktop OAuth client ID.
GOOGLE_OAUTH_CLIENT_IDS=000000000000-example.apps.googleusercontent.com

# Exact origins allowed to call the API from supported desktop/webviews.
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost

# Empty-Roles bootstrap verification claim lifetime (60–3600 seconds).
BOOTSTRAP_CLAIM_TTL_SECONDS=600

# Local repository tests only. Never set this in Cloud Run.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
